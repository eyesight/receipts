---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const allRecipes = await getCollection("recipes");
const recipes = allRecipes
  .sort((a: CollectionEntry<"recipes">, b: CollectionEntry<"recipes">) =>
    b.data.createdAt.getTime() - a.data.createdAt.getTime()
  )
  .slice(0, 6);
---

<BaseLayout title="Rezepte">
  <div class="space-y-8">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold tracking-tight">Neueste Rezepte</h1>
      <a href="/recipes/" class="text-sm text-stone-500 underline hover:no-underline">
        Alle Rezepte →
      </a>
    </div>

    {
      recipes.length === 0 ? (
        <p class="text-stone-500">
          Noch keine Rezepte.{" "}
          <a href="/admin/ocr" class="underline hover:no-underline">
            Erstes importieren
          </a>
        </p>
      ) : (
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {recipes.map((r) => (
            <li>
              <a
                href={`/recipes/${r.slug}`}
                class="group flex h-full flex-col rounded-lg border border-stone-200 bg-white p-5 shadow-sm transition hover:border-stone-400 hover:shadow"
              >
                {r.data.image && (
                  <img
                    src={r.data.image}
                    alt={r.data.title}
                    class="mb-4 h-40 w-full rounded object-cover"
                  />
                )}
                <h2 class="font-semibold group-hover:underline">{r.data.title}</h2>
                {r.data.description && (
                  <p class="mt-1 line-clamp-2 text-sm text-stone-500">
                    {r.data.description}
                  </p>
                )}
                <div class="mt-auto flex flex-wrap gap-2 pt-3">
                  {r.data.category && (
                    <span class="rounded-full bg-stone-100 px-2 py-0.5 text-xs text-stone-600">
                      {r.data.category}
                    </span>
                  )}
                  {r.data.prepTime && (
                    <span class="text-xs text-stone-400">
                      {r.data.prepTime + (r.data.cookTime ?? 0)} Min.
                    </span>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
