---
export const prerender = true;
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import RandomRecipes from "@/components/react/RandomRecipes";

const allRecipes = await getCollection("recipes");
const recipes = allRecipes.sort(
  (a: CollectionEntry<"recipes">, b: CollectionEntry<"recipes">) =>
    b.data.createdAt.getTime() - a.data.createdAt.getTime()
);

const categories = [
  ...new Set(allRecipes.map((r: CollectionEntry<"recipes">) => r.data.category).filter(Boolean)),
] as string[];

const recipeProps = recipes.map((r: CollectionEntry<"recipes">) => ({
  slug: r.slug,
  title: r.data.title,
  image: r.data.image ?? undefined,
  category: r.data.category ?? undefined,
}));
---

<BaseLayout title="Rezepte">

  <!-- H1 — centred, full-width, large Lora, like glace's TitleH1 -->
  <h1 style="text-align:center;margin-bottom:var(--spacing-m);">
    Hey.<br />Hie findsch üsi Rezept-Sammlig
  </h1>

  <!-- Searchbar — pill with teal border, fills on hover/focus -->
  <div style="margin-bottom:var(--spacing-l);display:flex;justify-content:center;">
    <div style="width:100%;max-width:80%;">
      <input
        id="search-input"
        type="search"
        placeholder="Nach Rezepten oder Zutaten suchen"
        class="search-pill"
      />
    </div>
  </div>

  <!-- Category tags — #name style, like glace's main-nav tags -->
  {categories.length > 0 && (
    <div
      id="category-filter"
      style="display:flex;flex-wrap:wrap;justify-content:center;gap:1.25rem;margin-bottom:var(--spacing-l);"
    >
      <button data-filter="all" class="tag-link active-tag">Alle</button>
      {categories.map((cat) => (
        <button data-filter={cat} class="tag-link">{cat}</button>
      ))}
    </div>
  )}

  <!-- Tiles section header — like glace's TitleH2 in Tile -->
  <h2 id="tiles-title" style="margin-bottom:var(--spacing-s);">
    {recipes.length} Rezepte
  </h2>

  <!-- Recipe tiles grid -->
  {
    recipes.length === 0 ? (
      <p style="font-family:'Lora',serif;font-size:var(--font-h3);color:rgba(40,44,41,0.3);">
        Noch keine Rezepte.
        {import.meta.env.DEV && (
          <a href="/admin/ocr" style="color:var(--color-turkies);">Erstes importieren</a>
        )}
      </p>
    ) : (
      <ul class="tiles-grid" id="recipe-grid" style="list-style:none;padding:0;margin:0;">
        {recipes.map((r: CollectionEntry<"recipes">) => (
          <li class="tile" data-category={r.data.category ?? ""} data-title={r.data.title.toLowerCase()}>
            <a href={`/recipes/${r.slug}`} style="display:block;text-decoration:none;color:inherit;">
              <!-- Image wrapper with teal hover overlay -->
              <div class="tile-image" style="aspect-ratio:16/9;background:#fff;">
                {r.data.image ? (
                  <img
                    src={r.data.image}
                    alt={r.data.title}
                    style="width:100%;height:100%;object-fit:cover;display:block;"
                  />
                ) : (
                  <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;border:4px solid var(--color-turkies);">
                    <svg style="width:33%;height:auto;color:var(--color-turkies);" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 120" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="50" cy="68" r="28"/>
                      <line x1="8" y1="5" x2="8" y2="26"/>
                      <line x1="12" y1="5" x2="12" y2="26"/>
                      <line x1="16" y1="5" x2="16" y2="26"/>
                      <path d="M8 26 Q8 33 12 33 Q16 33 16 26"/>
                      <line x1="12" y1="33" x2="12" y2="115"/>
                      <line x1="88" y1="5" x2="88" y2="115"/>
                      <path d="M88 5 Q82 5 82 26 L88 26"/>
                    </svg>
                  </div>
                )}
              </div>
              <!-- Tile content -->
              <div style="padding:1rem 0 4rem;">
                <h3 class="tile-anchor" style="margin-bottom:0;">{r.data.title}</h3>
                {r.data.category && (
                  <span class="tag-link" style="font-size:0.875rem;margin-top:0.5rem;display:inline-block;">
                    {r.data.category}
                  </span>
                )}
              </div>
            </a>
          </li>
        ))}
      </ul>
    )
  }

  <!-- Random recipes slideshow — glace's Slideshow component equivalent -->
  <div style="margin-top:var(--spacing-l);">
    <RandomRecipes client:load recipes={recipeProps} />
  </div>

</BaseLayout>

<style>
  .tile-anchor {
    transition: color 0.2s ease;
  }
  .tile:hover .tile-anchor,
  .tile:focus-within .tile-anchor {
    color: var(--color-turkies);
  }
  .active-tag {
    color: var(--color-turkies);
  }
  .active-tag::before {
    color: var(--color-turkies);
  }
</style>

<script>
  const filter = document.getElementById("category-filter");
  const grid = document.getElementById("recipe-grid");
  const tilesTitle = document.getElementById("tiles-title");
  const searchInput = document.getElementById("search-input") as HTMLInputElement | null;

  let activeCategory = "all";
  let searchQuery = "";

  function applyFilters() {
    const allItems = grid?.querySelectorAll<HTMLLIElement>("li[data-category]") ?? [];
    let visibleCount = 0;
    allItems.forEach((li) => {
      const matchesCategory = activeCategory === "all" || li.dataset.category === activeCategory;
      const matchesSearch = li.dataset.title?.includes(searchQuery) ?? true;
      const visible = matchesCategory && matchesSearch;
      li.style.display = visible ? "" : "none";
      if (visible) visibleCount++;
    });
    if (tilesTitle) tilesTitle.textContent = `${visibleCount} Rezepte`;
  }

  filter?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest("[data-filter]") as HTMLButtonElement | null;
    if (!btn) return;
    activeCategory = btn.dataset.filter ?? "all";
    filter.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((b) => {
      b.classList.remove("active-tag");
    });
    btn.classList.add("active-tag");
    applyFilters();
  });

  searchInput?.addEventListener("input", () => {
    searchQuery = searchInput.value.toLowerCase();
    applyFilters();
  });
</script>
