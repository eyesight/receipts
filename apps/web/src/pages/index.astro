---
export const prerender = true;
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const allRecipes = await getCollection("recipes");
const recipes = allRecipes.sort(
  (a: CollectionEntry<"recipes">, b: CollectionEntry<"recipes">) =>
    b.data.createdAt.getTime() - a.data.createdAt.getTime()
);

const categories = [...new Set(allRecipes.map((r) => r.data.category).filter(Boolean))] as string[];
---

<BaseLayout title="Rezepte">
  <div class="space-y-8">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold tracking-tight">Alle Rezepte</h1>
      <a href="/recipes/" class="text-sm text-stone-500 underline hover:no-underline">
        Neueste Rezepte →
      </a>
    </div>

    <input
      id="search-input"
      type="search"
      placeholder="Rezepte suchen…"
      class="w-full rounded-lg border border-stone-300 bg-white px-4 py-2 text-sm shadow-sm focus:border-stone-500 focus:outline-none"
    />

    {categories.length > 0 && (
      <div class="flex flex-wrap gap-2" id="category-filter">
        <button
          data-filter="all"
          class="rounded-full border border-stone-900 bg-stone-900 px-3 py-1 text-sm text-white"
        >
          Alle
        </button>
        {categories.map((cat) => (
          <button
            data-filter={cat}
            class="rounded-full border border-stone-300 px-3 py-1 text-sm hover:bg-stone-100"
          >
            {cat}
          </button>
        ))}
      </div>
    )}

    {
      recipes.length === 0 ? (
        <p class="text-stone-500">
          Noch keine Rezepte.{" "}
          <a href="/admin/ocr" class="underline hover:no-underline">
            Erstes importieren
          </a>
        </p>
      ) : (
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" id="recipe-grid">
          {recipes.map((r: CollectionEntry<"recipes">) => (
            <li data-category={r.data.category ?? ""} data-title={r.data.title.toLowerCase()}>
              <a
                href={`/recipes/${r.slug}`}
                class="group flex h-full flex-col rounded-lg border border-stone-200 bg-white p-5 shadow-sm transition hover:border-stone-400 hover:shadow"
              >
                {r.data.image && (
                  <img
                    src={r.data.image}
                    alt={r.data.title}
                    class="mb-4 h-40 w-full rounded object-cover"
                  />
                )}
                <h2 class="font-semibold group-hover:underline">{r.data.title}</h2>
                {r.data.description && (
                  <p class="mt-1 line-clamp-2 text-sm text-stone-500">
                    {r.data.description}
                  </p>
                )}
                <div class="mt-auto flex flex-wrap gap-2 pt-3">
                  {r.data.category && (
                    <span class="rounded-full bg-stone-100 px-2 py-0.5 text-xs text-stone-600">
                      {r.data.category}
                    </span>
                  )}
                  {r.data.prepTime && (
                    <span class="text-xs text-stone-400">
                      {r.data.prepTime + (r.data.cookTime ?? 0)} Min.
                    </span>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

<script>
  const filter = document.getElementById("category-filter");
  const grid = document.getElementById("recipe-grid");
  const searchInput = document.getElementById("search-input") as HTMLInputElement | null;

  let activeCategory = "all";
  let searchQuery = "";

  function applyFilters() {
    grid?.querySelectorAll<HTMLLIElement>("li[data-category]").forEach((li) => {
      const matchesCategory = activeCategory === "all" || li.dataset.category === activeCategory;
      const matchesSearch = li.dataset.title?.includes(searchQuery) ?? true;
      li.style.display = matchesCategory && matchesSearch ? "" : "none";
    });
  }

  filter?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest("[data-filter]") as HTMLButtonElement | null;
    if (!btn) return;

    activeCategory = btn.dataset.filter ?? "all";

    filter.querySelectorAll("[data-filter]").forEach((b) => {
      b.classList.remove("bg-stone-900", "text-white", "border-stone-900");
      b.classList.add("border-stone-300");
    });
    btn.classList.add("bg-stone-900", "text-white", "border-stone-900");
    btn.classList.remove("border-stone-300");

    applyFilters();
  });

  searchInput?.addEventListener("input", () => {
    searchQuery = searchInput.value.toLowerCase();
    applyFilters();
  });
</script>
