---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getRecipes } from "@/lib/db/queries";

const recipes = await getRecipes({ isPublished: false, limit: 1000 });
---

<BaseLayout title="Rezepte">
  <div class="space-y-8">
    <h1 class="text-2xl font-bold tracking-tight">Alle Rezepte</h1>

    {
      recipes.length === 0 ? (
        <p class="text-stone-500">
          Noch keine Rezepte.{" "}
          <a href="/admin/ocr" class="underline hover:no-underline">
            Erstes importieren
          </a>
        </p>
      ) : (
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {recipes.map((r) => (
            <li>
              <a
                href={`/recipes/${r.slug}`}
                class="group flex h-full flex-col rounded-lg border border-stone-200 bg-white p-5 shadow-sm transition hover:border-stone-400 hover:shadow"
              >
                {r.imageUrl && (
                  <img
                    src={r.imageUrl}
                    alt={r.title}
                    class="mb-4 h-40 w-full rounded object-cover"
                  />
                )}
                <h2 class="font-semibold group-hover:underline">{r.title}</h2>
                {r.description && (
                  <p class="mt-1 line-clamp-2 text-sm text-stone-500">
                    {r.description}
                  </p>
                )}
                <div class="mt-auto flex flex-wrap gap-2 pt-3">
                  {r.category && (
                    <span class="rounded-full bg-stone-100 px-2 py-0.5 text-xs text-stone-600">
                      {r.category.name}
                    </span>
                  )}
                  {r.prepTime && (
                    <span class="text-xs text-stone-400">{r.prepTime + (r.cookTime ?? 0)} Min.</span>
                  )}
                  {r.difficulty && (
                    <span class="text-xs text-stone-400 capitalize">{r.difficulty}</span>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
