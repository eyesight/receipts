---
// Only available in local dev
import BaseLayout from "@/layouts/BaseLayout.astro";
import ImageUpload from "@/components/react/ImageUpload";
import { readdirSync, statSync, readFileSync } from "fs";
import { join } from "path";

if (!import.meta.env.DEV) {
  return Astro.redirect("/");
}

const contentDir = join(process.cwd(), "src", "content", "recipes");

const imports = readdirSync(contentDir)
  .filter((f) => f.endsWith(".md"))
  .map((f) => {
    const filePath = join(contentDir, f);
    const mtime = statSync(filePath).mtime;
    const slug = f.replace(/\.md$/, "");
    const raw = readFileSync(filePath, "utf-8");
    const titleMatch = raw.match(/^title:\s*"?([^"\n]+)"?/m);
    const title = titleMatch ? titleMatch[1].trim() : slug;
    return { slug, title, mtime };
  })
  .sort((a, b) => b.mtime.getTime() - a.mtime.getTime())
  .slice(0, 10);
---

<BaseLayout title="Rezept via Foto importieren">
  <div class="space-y-12">
    <div>
      <h1 class="mb-2 text-2xl font-bold tracking-tight">Rezept importieren</h1>
      <p class="text-sm text-stone-500">
        Foto eines Rezepts hochladen — Claude erkennt Zutaten und Zubereitung automatisch.
      </p>
    </div>

    <div class="max-w-xl">
      <ImageUpload client:load />
    </div>

    <!-- Recent imports -->
    <div>
      <h2 class="mb-4 text-lg font-semibold">Letzte Importe</h2>

      {
        imports.length === 0 ? (
          <p class="text-sm text-stone-400">Noch keine Importe vorhanden.</p>
        ) : (
          <div class="overflow-hidden rounded-lg border border-stone-200">
            <table class="w-full text-sm">
              <thead class="bg-stone-50 text-left text-xs font-medium uppercase tracking-wide text-stone-500">
                <tr>
                  <th class="px-4 py-3">Rezept</th>
                  <th class="px-4 py-3">Datum</th>
                  <th class="px-4 py-3"></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-stone-100">
                {imports.map((imp) => (
                  <tr class="hover:bg-stone-50">
                    <td class="px-4 py-3">
                      <a
                        href={`/admin/recipes/${imp.slug}/edit`}
                        class="font-medium hover:underline"
                      >
                        {imp.title}
                      </a>
                    </td>
                    <td class="px-4 py-3 text-stone-500">
                      {imp.mtime.toLocaleDateString("de-CH", {
                        day: "2-digit",
                        month: "2-digit",
                        year: "numeric",
                        hour: "2-digit",
                        minute: "2-digit",
                      })}
                    </td>
                    <td class="px-4 py-3">
                      <a href={`/admin/recipes/${imp.slug}/edit`} class="text-xs text-stone-400 underline hover:text-stone-700">
                        bearbeiten
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>
