---
export const prerender = false;

import { getEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import RecipeEditForm from "@/components/react/RecipeEditForm";

const { slug } = Astro.params;
const entry = await getEntry("recipes", slug!);

if (!entry) return Astro.redirect("/recipes/");

const { data: r } = entry;

const initial = {
  title: r.title,
  description: r.description ?? "",
  servings: r.servings?.toString() ?? "",
  prepTime: r.prepTime?.toString() ?? "",
  cookTime: r.cookTime?.toString() ?? "",
  difficulty: r.difficulty ?? "",
  category: r.category ?? "",
  source: "",
  isPublished: true,
  imageUrl: r.image ?? "",
  ingredients: r.ingredients.map((ing: typeof r.ingredients[number]) => ({
    name: ing.name,
    amount: ing.amount ?? "",
    unit: ing.unit ?? "",
    note: ing.note ?? "",
    isOptional: ing.isOptional ?? false,
    group: ing.group ?? "",
  })),
  steps: r.steps.map((s: typeof r.steps[number]) => ({
    title: s.title ?? "",
    description: s.text,
    duration: s.duration?.toString() ?? "",
    tip: s.tip ?? "",
  })),
  tags: r.tags.join(", "),
};
---

<BaseLayout title={`Bearbeiten: ${r.title}`}>
  <div class="max-w-2xl space-y-6">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold tracking-tight">Rezept bearbeiten</h1>
      <a href={`/recipes/${slug}`} class="text-sm text-stone-500 hover:text-stone-900">
        ← Ansicht
      </a>
    </div>

    <RecipeEditForm slug={slug!} initial={initial} client:load />
  </div>
</BaseLayout>
