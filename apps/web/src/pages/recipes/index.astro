---
export const prerender = true;
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const allRecipes = await getCollection("recipes");
const recipes = allRecipes
  .sort((a: CollectionEntry<"recipes">, b: CollectionEntry<"recipes">) =>
    b.data.createdAt.getTime() - a.data.createdAt.getTime()
  );
---

<BaseLayout title="Neueste Rezepte">

  <h1 style="text-align:center;margin-bottom:var(--spacing-m);">
    Neueste Rezepte
  </h1>

  <a
    href="/"
    class="tag-link"
    style="display:inline-block;margin-bottom:var(--spacing-l);"
  >
    Alle Rezepte
  </a>

  {
    recipes.length === 0 ? (
      <p style="font-family:'Lora',serif;font-size:var(--font-h3);color:rgba(40,44,41,0.3);">
        Noch keine Rezepte vorhanden.
      </p>
    ) : (
      <div>
        <h2 style="margin-bottom:var(--spacing-s);">{recipes.length} Rezepte</h2>
        <ul id="recipes-list" class="tiles-grid" style="list-style:none;padding:0;margin:0;">
          {recipes.map((r: CollectionEntry<"recipes">, i: number) => (
            <li class="tile" data-index={i} style={i >= 9 ? "display:none;" : ""}>
              <a href={`/recipes/${r.slug}`} style="display:block;text-decoration:none;color:inherit;">
                {r.data.image && (
                  <div class="tile-image" style="aspect-ratio:16/9;background:#fff;">
                    <img
                      src={r.data.image}
                      alt={r.data.title}
                      style="width:100%;height:100%;object-fit:cover;display:block;"
                    />
                  </div>
                )}
                <div style="padding:1rem 0 4rem;">
                  <h3 class="tile-anchor" style="margin-bottom:0;">{r.data.title}</h3>
                  {r.data.category && (
                    <span class="tag-link" style="font-size:0.875rem;margin-top:0.5rem;display:inline-block;">
                      {r.data.category}
                    </span>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
        {recipes.length > 9 && (
          <div style="text-align:center;margin-top:var(--spacing-l);">
            <button id="load-more-btn" class="btn-primary">
              Load more
            </button>
          </div>
        )}
      </div>
    )
  }

</BaseLayout>

<style>
  .tile-anchor {
    transition: color 0.2s ease;
  }
  .tile:hover .tile-anchor,
  .tile:focus-within .tile-anchor {
    color: var(--color-turkies);
  }
</style>

<script>
  const btn = document.getElementById("load-more-btn");
  if (btn) {
    let shown = 9;
    const PAGE = 9;
    btn.addEventListener("click", () => {
      const items = document.querySelectorAll<HTMLElement>("#recipes-list li[data-index]");
      const next = shown + PAGE;
      items.forEach((item) => {
        const idx = parseInt(item.dataset.index ?? "0", 10);
        if (idx >= shown && idx < next) item.style.display = "";
      });
      shown = next;
      if (shown >= items.length) btn.parentElement!.style.display = "none";
    });
  }
</script>
