---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");
  return recipes.map((entry: CollectionEntry<"recipes">) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"recipes">;
}

const { entry } = Astro.props;
const { data: recipe } = entry;
const { Content } = await entry.render();

const totalTime = (recipe.prepTime ?? 0) + (recipe.cookTime ?? 0);

const difficultyLabel: Record<string, string> = {
  easy: "Einfach",
  medium: "Mittel",
  hard: "Schwer",
};
---

<BaseLayout title={recipe.title}>
  <article class="mx-auto max-w-2xl space-y-10">

    <!-- Header -->
    <div class="space-y-3">
      {recipe.category && (
        <p class="text-sm font-medium uppercase tracking-wide text-stone-400">
          {recipe.category}
        </p>
      )}
      <h1 class="text-3xl font-bold tracking-tight">{recipe.title}</h1>
      {recipe.description && (
        <p class="text-stone-600">{recipe.description}</p>
      )}

      <!-- Meta row -->
      <dl class="flex flex-wrap gap-6 pt-1 text-sm">
        {recipe.servings && (
          <div>
            <dt class="text-stone-400">Portionen</dt>
            <dd class="font-medium">{recipe.servings}</dd>
          </div>
        )}
        {recipe.prepTime && (
          <div>
            <dt class="text-stone-400">Vorbereitung</dt>
            <dd class="font-medium">{recipe.prepTime} Min.</dd>
          </div>
        )}
        {recipe.cookTime && (
          <div>
            <dt class="text-stone-400">Kochzeit</dt>
            <dd class="font-medium">{recipe.cookTime} Min.</dd>
          </div>
        )}
        {totalTime > 0 && (
          <div>
            <dt class="text-stone-400">Gesamt</dt>
            <dd class="font-medium">{totalTime} Min.</dd>
          </div>
        )}
        {recipe.difficulty && (
          <div>
            <dt class="text-stone-400">Schwierigkeit</dt>
            <dd class="font-medium">{difficultyLabel[recipe.difficulty]}</dd>
          </div>
        )}
      </dl>

      <!-- Tags -->
      {recipe.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 pt-1">
          {recipe.tags.map((tag) => (
            <span class="rounded-full bg-stone-100 px-3 py-0.5 text-xs text-stone-600">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>

    <!-- Image -->
    {recipe.image && (
      <img
        src={recipe.image}
        alt={recipe.title}
        class="w-full rounded-lg object-cover shadow"
        style="max-height: 400px"
      />
    )}

    <!-- Ingredients -->
    {recipe.ingredients.length > 0 && (
      <section>
        <h2 class="mb-4 text-lg font-semibold">Zutaten</h2>
        <ul class="space-y-2">
          {recipe.ingredients.map(({ name, amount, unit }) => (
            <li class="flex gap-3 text-sm">
              <span class="w-20 shrink-0 text-right text-stone-500">
                {amount ?? ""}
                {unit ? ` ${unit}` : ""}
              </span>
              <span>{name}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Steps -->
    {recipe.steps.length > 0 && (
      <section>
        <h2 class="mb-4 text-lg font-semibold">Zubereitung</h2>
        <ol class="space-y-6">
          {recipe.steps.map((step) => (
            <li class="flex gap-4">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-stone-900 text-xs font-bold text-white">
                {step.order}
              </span>
              <div class="space-y-1 pt-0.5">
                <p class="text-stone-700">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- Markdown body -->
    <div class="prose prose-stone max-w-none text-sm text-stone-500">
      <Content />
    </div>

  </article>
</BaseLayout>
