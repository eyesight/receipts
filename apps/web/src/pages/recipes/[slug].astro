---
export const prerender = true;
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");
  return recipes.map((entry: CollectionEntry<"recipes">) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"recipes">;
}

const { entry } = Astro.props;
const { data: recipe } = entry;
const { Content } = await entry.render();

const totalTime = (recipe.prepTime ?? 0) + (recipe.cookTime ?? 0);

const difficultyLabel: Record<string, string> = {
  easy: "Einfach",
  medium: "Mittel",
  hard: "Schwer",
};
---

<BaseLayout title={recipe.title}>

  <!-- Back link -->
  <a href="/" class="tag-link" style="display:inline-block;margin-bottom:var(--spacing-s);">
    Alle Rezepte
  </a>

  <!-- Category tag -->
  {recipe.category && (
    <p style="font-family:'Montserrat',sans-serif;font-size:0.875rem;margin-bottom:1rem;">
      <span class="tag-link">{recipe.category}</span>
    </p>
  )}

  <!-- H1 title — large, centered, Lora -->
  <h1 style="text-align:center;margin-bottom:var(--spacing-m);">{recipe.title}</h1>

  <!-- Lead / description -->
  {recipe.description && (
    <p
      style="
        font-family:'Lora',serif;
        font-size:var(--font-h3);
        line-height:1.5;
        text-align:center;
        margin-bottom:var(--spacing-m);
        max-width:40ch;
        margin-left:auto;
        margin-right:auto;
      "
    >
      {recipe.description}
    </p>
  )}

  <!-- Meta row -->
  <dl
    style="
      display:flex;
      flex-wrap:wrap;
      gap:2.5rem;
      border-top:2px solid var(--color-blacky);
      padding-top:2rem;
      margin-bottom:var(--spacing-m);
    "
  >
    {recipe.servings && (
      <div>
        <dt style="font-family:'Montserrat',sans-serif;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.1em;color:rgba(40,44,41,0.4);margin-bottom:0.4rem;">
          Portionen
        </dt>
        <dd style="font-family:'Lora',serif;font-size:var(--font-h3);">{recipe.servings}</dd>
      </div>
    )}
    {recipe.prepTime && (
      <div>
        <dt style="font-family:'Montserrat',sans-serif;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.1em;color:rgba(40,44,41,0.4);margin-bottom:0.4rem;">
          Vorbereitung
        </dt>
        <dd style="font-family:'Lora',serif;font-size:var(--font-h3);">{recipe.prepTime} Min.</dd>
      </div>
    )}
    {recipe.cookTime && (
      <div>
        <dt style="font-family:'Montserrat',sans-serif;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.1em;color:rgba(40,44,41,0.4);margin-bottom:0.4rem;">
          Kochzeit
        </dt>
        <dd style="font-family:'Lora',serif;font-size:var(--font-h3);">{recipe.cookTime} Min.</dd>
      </div>
    )}
    {totalTime > 0 && (
      <div>
        <dt style="font-family:'Montserrat',sans-serif;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.1em;color:rgba(40,44,41,0.4);margin-bottom:0.4rem;">
          Gesamt
        </dt>
        <dd style="font-family:'Lora',serif;font-size:var(--font-h3);color:var(--color-turkies);">
          {totalTime} Min.
        </dd>
      </div>
    )}
    {recipe.difficulty && (
      <div>
        <dt style="font-family:'Montserrat',sans-serif;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.1em;color:rgba(40,44,41,0.4);margin-bottom:0.4rem;">
          Schwierigkeit
        </dt>
        <dd style="font-family:'Lora',serif;font-size:var(--font-h3);">{difficultyLabel[recipe.difficulty]}</dd>
      </div>
    )}
  </dl>

  <!-- Tags -->
  {recipe.tags.length > 0 && (
    <div style="display:flex;flex-wrap:wrap;gap:1rem;margin-bottom:var(--spacing-m);">
      {recipe.tags.map((tag: string) => (
        <span class="tag-link">{tag}</span>
      ))}
    </div>
  )}

  <!-- Image -->
  {recipe.image && (
    <div
      style="
        position:relative;
        width:100%;
        aspect-ratio:16/9;
        overflow:hidden;
        margin-bottom:var(--spacing-l);
      "
    >
      <img
        src={recipe.image}
        alt={recipe.title}
        style="width:100%;height:100%;object-fit:cover;display:block;"
      />
    </div>
  )}

  <!-- Ingredients -->
  {recipe.ingredients.length > 0 && (
    <section style="margin-bottom:var(--spacing-l);">
      <h2 style="margin-bottom:var(--spacing-s);">Zutaten</h2>
      <ul style="list-style:none;padding:0;margin:0;">
        {recipe.ingredients.map(({ name, amount, unit }: typeof recipe.ingredients[number]) => (
          <li
            style="
              display:flex;
              gap:1.5rem;
              align-items:baseline;
              border-bottom:1px solid rgba(40,44,41,0.08);
              padding:0.875rem 0;
            "
          >
            <span
              style="
                font-family:'Montserrat',sans-serif;
                font-size:0.875rem;
                color:rgba(40,44,41,0.4);
                width:6rem;
                flex-shrink:0;
                text-align:right;
              "
            >
              {amount ?? ""}{unit ? ` ${unit}` : ""}
            </span>
            <span style="font-family:'Lora',serif;font-size:var(--font-h3);">{name}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Steps -->
  {recipe.steps.length > 0 && (
    <section style="margin-bottom:var(--spacing-l);">
      <h2 style="margin-bottom:var(--spacing-s);">Zubereitung</h2>
      <ol style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:var(--spacing-m);">
        {recipe.steps.map((step: typeof recipe.steps[number]) => (
          <li style="display:flex;gap:2rem;">
            <span
              aria-hidden="true"
              style="
                font-family:'Lora',serif;
                font-size:var(--font-h2);
                color:var(--color-turkies);
                line-height:1;
                flex-shrink:0;
                margin-top:-0.1em;
              "
            >
              {step.order}
            </span>
            <div style="padding-top:0.25rem;">
              {step.title && (
                <p style="font-family:'Lora',serif;font-size:var(--font-h3);margin-bottom:0.75rem;">
                  {step.title}
                </p>
              )}
              <p style="font-family:'Montserrat',sans-serif;line-height:1.7;color:rgba(40,44,41,0.7);">
                {step.text}
              </p>
              {step.tip && (
                <p
                  style="
                    font-family:'Montserrat',sans-serif;
                    font-size:0.875rem;
                    color:var(--color-turkies);
                    border-left:2px solid var(--color-turkies);
                    padding-left:1rem;
                    margin-top:0.75rem;
                  "
                >
                  {step.tip}
                </p>
              )}
              {step.duration && (
                <p style="font-family:'Montserrat',sans-serif;font-size:0.75rem;color:rgba(40,44,41,0.3);margin-top:0.5rem;">
                  {step.duration} Min.
                </p>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>
  )}

  <!-- Markdown body -->
  <div class="prose-content">
    <Content />
  </div>

  {import.meta.env.DEV && (
    <a
      href={`/admin/recipes/${entry.slug}/edit`}
      class="tag-link"
      style="
        display:inline-block;
        font-size:0.75rem;
        margin-top:var(--spacing-l);
        opacity:0.4;
      "
    >
      Rezept bearbeiten
    </a>
  )}

</BaseLayout>

<style>
  .prose-content {
    font-family: "Montserrat", sans-serif;
    font-size: var(--font-body);
    line-height: 1.7;
    color: rgba(40, 44, 41, 0.7);
  }
  .prose-content p { margin-bottom: 1.25em; }
  .prose-content h2 { margin-top: 2em; margin-bottom: 0.75em; }
  .prose-content h3 { margin-top: 1.5em; margin-bottom: 0.5em; }
</style>
